      .skill {
        background:#eef2f6;
        padding:6px 10px;
        border-radius:6px;
        font-size:12px;
        border:1px solid #e2e8f0;
      }

      @media print {
        .page { margin:0; box-shadow:none; }
        a[href]:after { content:none; }
      }
