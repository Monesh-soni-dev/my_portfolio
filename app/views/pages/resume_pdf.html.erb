      .icons a svg { transition:0.2s; }
      .icons a:hover svg { color:var(--accent); }

      /* Sections */
      .section { margin-top:22px; }
      .section h3 {
        margin:0 0 8px 0;
        font-size:17px;
        font-weight:700;
        border-left:4px solid var(--accent);
        padding-left:8px;
      }

      .muted { color:var(--muted); font-size:13px; }

      ul { margin:6px 0 0 20px; }

      /* Two Column Layout */
      .two-col { display:flex; gap:18px; }
      .col { flex:1; }

      /* Skills */
