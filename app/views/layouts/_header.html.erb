<header class="site-header">
  <div class="topbar">
    <div class="container header-row">
      <!-- Brand / Logo -->
      <div class="brand">
        <%= link_to root_path, class: "brand-link" do %>
          <span class="logo">Monesh Soni</span>
          <span class="sub">Full-Stack Rails Developer</span>
        <% end %>
      </div>

      <!-- Navigation -->
      <nav class="main-nav" aria-label="Primary">
        <ul class="nav-list">
          <li><%= link_to "Home", root_path, class: "nav-link" %></li>
          <li><%= link_to "Projects", projects_path, class: "nav-link" %></li>
          <li><%= link_to "About", about_path, class: "nav-link" %></li>
          <li>
            <a href="<%= resume_print_path %>" target="_blank" rel="noopener" class="nav-link">Resume</a>
          </li>
        </ul>
        <%= link_to "Contact", contact_path, class: "nav-cta" %>
      </nav>
    </div>
  </div>
</header>
